{
	"name": "medienbaecker/kirby-base-select",
	"description": "A select field for the Kirby Panel with icons, images, info, fonts and themes on every option",
	"license": "MIT",
	"type": "kirby-plugin",
	"version": "1.0.0",
	"authors": [
		{
			"name": "Thomas Günther",
			"email": "mail@medienbaecker.com"
		}
	],
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0",
		"getkirby/cms": "^6.0",
		"getkirby/composer-installer": "^1.2"
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"archive": {
		"exclude": [
			".DS_Store",
			".gitignore",
			"composer.lock",
			"node_modules/",
			"package-lock.json",
			"package.json",
			"src/",
			"vendor/"
		]
	}
}
